{
  "rewrites": [
    {
      "source": "/hostel/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(facebookexternalhit|WhatsApp|Twitterbot|LinkedInBot|TelegramBot|Slackbot).*"
        }
      ],
      "destination": "https://api.kaunsahostel.com/hostel/:slug"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
